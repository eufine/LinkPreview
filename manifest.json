{
  "manifest_version": 3,
  "name": "Link Preview",
  "version": "3.2.0",
  "description": "Drag or Alt+Click any link to preview it in an in-page popup without navigating away.",
  "icons": {
    "16": "icons/eye-16.png",
    "48": "icons/eye-48.png",
    "128": "icons/eye-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "css": ["popup.css"],
      "js": ["iframe-textselect.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}